{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.tailwindcss.com; font-src fonts.gstatic.com; img-src 'self' data: lh3.googleusercontent.com www.gstatic.com api.qrserver.com; frame-src maps.google.com; connect-src 'self' cdn.tailwindcss.com" }
      ]
    }
  ],
  "redirects": [
    { "source": "/preservadas.html", "destination": "/catalogo-completo.html", "statusCode": 301 },
    { "source": "/rosas-clasicas.html", "destination": "/catalogo-completo.html", "statusCode": 301 },
    { "source": "/ramo-especial-alameda.html", "destination": "/catalogo-completo.html", "statusCode": 301 },
    { "source": "/ramo-brisas-alameda.html", "destination": "/catalogo-completo.html", "statusCode": 301 }
  ]
}
